        "T1",
        "T2",
        "T3",
        "T4",
        "T5a",
        "T5b",
        "T6",
        "T7",
        "TFL"
      ],
      "dp_width_and_calc": [
        "DP_A",
        "DP_B"
      ]
    }
  },
