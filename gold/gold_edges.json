{
  "_meta": {
    "benchmark": "OmniMart column-lineage hard-transform benchmark",
    "granularity": "column-to-column",
    "edge_semantics": "OpenLineage-style: DIRECT = output value derived from source value; INDIRECT = source influences output (filter/group/partition/order/join key) but is not the value source",
    "scope_note": "Only transform models carry edges. Bronze source tables are origins (no upstream). Each edge is tagged with the transform_type of the model that produced it, matching the paper taxonomy.",
    "transform_types": {
      "T1": "projection / rename",
      "T2": "multi-table join",
      "T3": "aggregate / GROUP BY",
      "T4": "CTE / nested subquery chain",
      "T5a": "static PIVOT (fixed IN-list)",
      "T5b": "dynamic PIVOT (ANY)",
      "T6": "derived calc (window / CASE / arithmetic)",
      "T7": "no-referential-integrity union + inferred-key merge",
      "TFL": "lateral flatten of semi-structured VARIANT",
      "DP_A": "DP-layer wide passthrough/rename data product (width + rename fidelity, repeated column families)",
      "DP_B": "DP-layer calculation-heavy data product (many-to-one derived expressions at width)"
    },
    "edge_fields": [
      "target_model",
      "target_column",
      "source_table",
      "source_column",
      "type",
      "transform_type"
    ],
    "difficulty_axes": {
